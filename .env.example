# Ejemplo; NO contiene credenciales. No se carga automáticamente.
# Local: SQLite, DEBUG activo. Hosting: estas variables se guardan en Vercel.
DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DATABASE_URL=
PUBLIC_SITE_URL=https://NOMBRE-PROYECTO.vercel.app
DJANGO_ALLOWED_HOSTS=NOMBRE-PROYECTO.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://NOMBRE-PROYECTO.vercel.app
# No guardar INITIAL_ADMIN_PASSWORD como variable permanente de Vercel.
